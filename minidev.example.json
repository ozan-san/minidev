{
  "stack": "auto",
  "models": {
    "scout": { "model": "openrouter/deepseek/deepseek-v4.1-flash", "thinking": "medium" },
    "planner": { "model": "openrouter/anthropic/claude-opus-5.5", "thinking": "high", "maxUsdPerCall": 3 },
    "builder": { "model": "openrouter/deepseek/deepseek-v4.1-flash", "thinking": "high" },
    "tester": { "model": "openrouter/deepseek/deepseek-v4.1-flash", "thinking": "high" },
    "reviewer": { "model": "openrouter/anthropic/claude-opus-5.5", "thinking": "medium" }
  },
  "budget": { "maxUsdPerRun": 10, "warnAt": 0.8 },
  "gates": { "plan": true, "pr": true },
  "git": {
    "remote": "origin",
    "baseBranch": "",
    "branchTemplate": "{type}/{key}-{slug}",
    "subtaskCommitTemplate": "{key}: {title}",
    "commitPerSubtask": true,
    "worktreeRoot": "~/.minidev/worktrees",
    "copyIntoWorktree": ["local.properties", ".env", ".env.local", "app/google-services.json"],
    "inPlace": false
  },
  "pr": { "push": true, "command": "auto", "draft": false },

  "//": "Per-mode defaults — best placed in ~/.minidev/config.json so they apply to all repos of that kind.",
  "stacks": {
    "android": {
      "checks": {
        "subtask": [{ "name": "compile", "command": "./gradlew --console=plain :app:compileFreeDebugKotlin", "timeoutSec": 1200 }],
        "final": [
          { "name": "assemble", "command": "./gradlew --console=plain assembleFreeDebug" },
          { "name": "unit-tests", "command": "./gradlew --console=plain testFreeDebugUnitTest", "when": "hasTests" },
          { "name": "detekt", "command": "./gradlew --console=plain detekt", "blocking": false }
        ]
      }
    },
    "ios": {
      "checks": {
        "subtask": [{ "name": "build", "command": "set -o pipefail; xcodebuild -workspace App.xcworkspace -scheme App -destination 'generic/platform=iOS Simulator' -quiet CODE_SIGNING_ALLOWED=NO build" }],
        "final": [
          { "name": "build", "command": "set -o pipefail; xcodebuild -workspace App.xcworkspace -scheme App -destination 'generic/platform=iOS Simulator' -quiet CODE_SIGNING_ALLOWED=NO build" },
          { "name": "test", "command": "set -o pipefail; xcodebuild -workspace App.xcworkspace -scheme App -destination 'platform=iOS Simulator,name=iPhone 16' -quiet CODE_SIGNING_ALLOWED=NO test", "when": "hasTests" }
        ]
      },
      "setup": ["bundle exec pod install"]
    }
  },

  "//checks": "Repo-level 'checks' / 'setup' override everything above and detection, e.g. in <repo>/.minidev.json:",
  "//example": { "checks": { "final": [{ "name": "ci", "command": "make ci" }] }, "setup": ["make bootstrap"] },

  "tests": { "write": "auto" },
  "limits": { "maxSubtasks": 12, "subtaskAttempts": 3, "fixRounds": 3, "reviewRounds": 1 },
  "durable": { "replay": "safe" },
  "ui": { "dismissOn": "done" }
}
